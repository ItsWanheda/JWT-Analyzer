{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JWT Analyzer Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessed_at",
    "verification_status",
    "signature_present",
    "verification",
    "policy",
    "header",
    "claims",
    "findings",
    "warnings",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "assessed_at": {
      "type": "string",
      "format": "date-time"
    },
    "verification_status": {
      "enum": [
        "not_attempted",
        "verified",
        "invalid",
        "error"
      ]
    },
    "signature_present": {
      "type": "boolean"
    },
    "verification": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "policy": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "header": {
      "type": "object",
      "additionalProperties": true
    },
    "claims": {
      "type": "object",
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "severity",
          "confidence",
          "category",
          "recommendation",
          "observation",
          "impact",
          "limitations",
          "stage",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string"
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "enum": [
              "inspection",
              "verification",
              "policy"
            ]
          },
          "evidence": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
